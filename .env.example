# DATABASE_URL=postgresql://user:password@host:5432/yunji
# INVITE_CODE=replace-with-a-long-random-invitation-code
# NODE_ENV=production requires PostgreSQL + HTTPS APP_ORIGIN + INVITE_CODE.
