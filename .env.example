# Local development only. Copy to .env; never commit secrets.
PORT=4100
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5174
# No DATABASE_URL = embedded PostgreSQL in this project's .local/database.
# DATABASE_URL=postgresql://user:password@host:5432/yunji
# INVITE_CODE=replace-with-a-long-random-invitation-code
# NODE_ENV=production requires PostgreSQL + HTTPS APP_ORIGIN + INVITE_CODE + SMTP.
# Real email is disabled locally unless all SMTP fields are configured.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=accounts@example.com
# SMTP_SECURE=false
# Port 465 uses TLS; other ports require STARTTLS and valid certificates.
# Development only: require verification before opening business pages.
# REQUIRE_VERIFIED_EMAIL=true
