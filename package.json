{
  "name": "yunji-business-commercial",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:api": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "node --experimental-strip-types --test tests/business-commercial.test.ts",
    "test:e2e": "node tests/commercial.e2e.mjs",
    "test:auth:e2e": "node tests/auth-recovery.e2e.mjs",
    "test:api": "node --experimental-strip-types --test tests/api.test.mjs",
    "test:security": "node --experimental-strip-types --test server/tests/hardening.test.ts",
    "test:recovery": "node --experimental-strip-types --test server/tests/recovery.test.ts",
    "check": "pnpm run build && pnpm run typecheck:server && pnpm run test && pnpm run test:api && pnpm run test:security && pnpm run test:recovery",
    "checkpoint": "node scripts/checkpoint.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@electric-sql/pglite": "^0.5.8",
    "antd": "^5.27.0",
    "dayjs": "^1.11.13",
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "nodemailer": "10.0.14",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "^1.63.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
